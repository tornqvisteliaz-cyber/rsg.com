# Copy these values into your hosting provider's environment settings.
# Never commit real secrets or a populated .env file.
PORT=8000

# PostgreSQL is recommended on Starto. Leave empty to use SQLite in DATA_DIR.
DATABASE_URL=postgresql://user:password@host:5432/database
# Only used with SQLite: must be persistent storage.
DATA_DIR=/data

# The first login with these values creates the Owner account.
ADMIN_USERNAME=eliaz
ADMIN_EMAIL=Eliaz@rotaidem.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
