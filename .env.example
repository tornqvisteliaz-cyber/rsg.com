# Copy these values into your hosting provider's environment settings.
# Never commit real secrets or a populated .env file.
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql://user:password@host:5432/database
PORT=8000

# Optional: set only to the number of trusted proxies that overwrite each header.
# Keep at 0 unless your hosting and Cloudflare proxy chain is confirmed.
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0

# Create the initial Owner account on first boot. Use a unique, strong password.
ADMIN_USERNAME=replace-with-owner-name
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_EMAIL=admin@example.com
# Set true for a single restart only to reset this account's password.
ADMIN_RESET_PASSWORD=false
