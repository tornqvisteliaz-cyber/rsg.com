# Set these in Render's Environment page.  Do not commit a real .env file.
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=Mandms
ADMIN_PASSWORD=replace-with-your-admin-password
ADMIN_EMAIL=admin@example.com
# Set to true for one deployment only if this existing account needs its
# password reset; set it back to false immediately afterwards.
ADMIN_RESET_PASSWORD=false
